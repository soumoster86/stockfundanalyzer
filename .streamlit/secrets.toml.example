# Copy this to .streamlit/secrets.toml locally (gitignored), OR paste into
# Streamlit Cloud → app → Settings → Secrets.
#
# Generate a password hash (PBKDF2 salt$hash):
#   python -m src.auth YOURPASSWORD

[auth.users]
# username = "salt$pbkdf2_hex_digest"
admin = "REPLACE_WITH_SALT$HASH_FROM_python_-m_src.auth"

# Optional: durable per-user watchlists + pipeline run log (Supabase / Postgres)
# 1. Run sql/watchlist_supabase.sql and sql/pipeline_runs_supabase.sql
# 2. Project Settings → API → Project URL + service_role key (server-only)
# 3. pip install supabase
# 4. Same url/key as GitHub Actions secrets SUPABASE_URL / SUPABASE_KEY
#    so the daily fundamentals workflow can log each run
#
# [supabase]
# url = "https://YOUR_PROJECT.supabase.co"
# key = "YOUR_SERVICE_ROLE_KEY"
